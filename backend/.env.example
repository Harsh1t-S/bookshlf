# Copy to backend/.env and fill in. Never commit .env.
PORT=4000

# MongoDB Atlas: Connect > Drivers > copy the connection string and put in your password.
# Run `npm run db:setup` once to create the indexes. Data lives in the "bookshelf" database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=bookshlf

# Long random string that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Google Cloud Console > Google Auth Platform > Clients > Web application > Client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Where the site runs; used to build password-reset links.
APP_ORIGIN=http://localhost:5173
