# Copy to backend/.env and fill in. Never commit .env.
PORT=4000

# Local MySQL: mysql://USER:PASSWORD@localhost:3306/bookshelf  (run `npm run db:setup` once to create it)
DATABASE_URL=mysql://root:YOUR_PASSWORD@localhost:3306/bookshelf
# Cloud MySQL (e.g. TiDB Cloud) needs TLS: append ?ssl={"rejectUnauthorized":true} to the URL.

# Long random string that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Google Cloud Console > Google Auth Platform > Clients > Web application > Client ID (same value as the frontend's VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Where the site runs; used to build password-reset links.
APP_ORIGIN=http://localhost:5173
