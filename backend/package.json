{
  "name": "bookshelf-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bookshelf.cv API: accounts (email + Google), shelves, usernames and Goodreads import.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "db:setup": "node --env-file-if-exists=.env db/setup.js",
    "test": "node --env-file-if-exists=.env --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^6.21.0"
  }
}
